# agent-voice-ai — environment configuration
#
# Copy to `.env` and fill in real values. .env is gitignored.
# All values shown here are placeholders; the bridge will refuse to start
# (or will degrade gracefully) if any required value is missing.

# ─── Brain (LLM) ────────────────────────────────────────────────────
# Required. The brain uses an Anthropic-compatible chat completions API.
# Default endpoint is api.minimax.io; set BRAIN_API_URL to point elsewhere.
BRAIN_API_KEY=«replace-me»
BRAIN_MODEL=MINIMAX-M3
# BRAIN_API_URL=https://api.minimax.io/anthropic/v1/messages

# Back-compat alias: if BRAIN_API_KEY is unset, brain.py falls back to
# BRAIN_API_KEY for the brain API. Falls back to MINIMAX_API_KEY for backward compat.
# BRAIN_API_KEY=«replace-me»

# ─── Telegram (optional, for send_message tool + sync poller) ────────
# Without these the bridge still runs, but the send_message tool and
# home-channel sync will be no-ops.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_HOME_CHANNEL=REPLACE_ME             # numeric chat_id (e.g. 123456789)

# ─── Bridge network ─────────────────────────────────────────────────
# Bind address. 0.0.0.0 = reachable from any interface (LAN, VPN, etc.).
# Use 127.0.0.1 to lock down to local-only.
AVA_HOST=0.0.0.0
AVA_PORT=8770

# CORS origins — comma-separated list. Default "*" is fine for a single-user
# local install; tighten to your phone's IP for stricter access control.
AVA_CORS_ORIGINS=*

# ─── TLS ────────────────────────────────────────────────────────────
# If server.crt / server.key exist under certs/ and these are unset,
# the bridge uses HTTPS with those files. Set AVA_HTTPS=0 to force
# plain HTTP for local dev (localhost only).
AVA_TLS_CERT=certs/server.crt
AVA_TLS_KEY=certs/server.key
# AVA_HTTPS=0   # uncomment to force HTTP

# ─── TTS provider selection ─────────────────────────────────────────
# 'piper' (default, requires piper CLI + onnx voice model)
# 'kokoro' (requires kokoro Python package + KPipeline weights)
AVA_TTS_PROVIDER=piper

# Piper CLI binary + voice model. Defaults shown; override if installed elsewhere.
PIPER_BIN=piper
PIPER_MODEL_DIR=~/.local/share/piper/voices
PIPER_MODEL=en_US-libritts_r-medium
# PIPER_SAMPLE_RATE=22050

# Kokoro voice. Default 'am_adam' (male). Other options: af_heart, bf_emma, am_michael.
# AVA_TTS_VOICE=am_adam

# ─── STT (whisper.cpp) ───────────────────────────────────────────────
# whisper.cpp HTTP server endpoint (must be running). Default port 8178.
WHISPER_URL=http://127.0.0.1:8178/inference
# WHISPER_TIMEOUT=30

# ─── Memory layer (override defaults; see memory.py) ───────────────
# Default paths follow XDG conventions and contain nothing out of the box.
# MEMORY_SOUL_PATH=~/.config/agent-voice-ai/SOUL.md
# MEMORY_INDEX_PATH=~/.config/agent-voice-ai/MEMORY_INDEX.md
# MEMORY_LIFE_DIR=~/.local/share/agent-voice-ai/life
# MEMORY_FACT_STORE_DB=~/.local/share/agent-voice-ai/facts.db
# MEMORY_SESSIONS_DIR=~/.local/share/agent-voice-ai/sessions

# ─── Skills loader (override defaults; see skills_bridge.py) ────────
# AVA_SKILLS_ROOT=~/.hermes/skills
# AVA_ALWAYS_LOAD_SKILLS=skill-one,skill-two
# AVA_TRIGGER_KEYWORDS_JSON={"my-keyword":["my-skill"]}

# ─── Debug ──────────────────────────────────────────────────────────
# Set to 1 to enable DEBUG-level logging in the bridge.
AVA_VERBOSE=0
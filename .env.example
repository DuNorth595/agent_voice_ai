# agent-voice-ai — environment configuration
#
# Copy to `.env` and fill in real values. .env is gitignored.
# All values shown here are placeholders; the bridge will refuse to start
# (or will degrade gracefully) if any required value is missing.

# ─── Anthropic (brain) ──────────────────────────────────────────────
# Required. Used by brain.py for chat completion + prompt caching.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Telegram (optional, for send_message tool + sync poller) ────────
# Without these the bridge still runs, but the send_message tool
# and home-channel sync will be no-ops.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_HOME_CHANNEL=REPLACE_ME             # numeric chat_id (e.g. 123456789)

# ─── Bridge network ─────────────────────────────────────────────────
VOICE_BRIDGE_HOST=0.0.0.0
VOICE_BRIDGE_PORT=8770

# ─── TLS ────────────────────────────────────────────────────────────
# If server.crt / server.key exist under certs/ and these are unset,
# the bridge uses HTTPS with those files. Set SAM_VOICE_HTTPS=0 to
# force plain HTTP for local dev (localhost only).
SAM_VOICE_TLS_CERT=certs/server.crt
SAM_VOICE_TLS_KEY=certs/server.key
# SAM_VOICE_HTTPS=0   # uncomment to force HTTP

# ─── TTS provider selection ─────────────────────────────────────────
# 'piper' (default, requires piper CLI + libritts_r onnx model)
# 'kokoro' (requires kokoro Python package + KPipeline weights)
SAM_VOICE_TTS_PROVIDER=piper

# ─── Debug ──────────────────────────────────────────────────────────
# Set to 1 to enable DEBUG-level logging in agent_voice_ai.
SAM_VOICE_VERBOSE=0

# ─── Paths to external services ─────────────────────────────────────
# whisper.cpp HTTP server endpoint (must be running). Defaults shown.
WHISPER_CPP_URL=http://localhost:8080/inference

# Piper CLI binary + voice model. Defaults shown; override if installed elsewhere.
PIPER_BIN=piper
PIPER_MODEL_PATH=/usr/share/piper-voices/en/en_US/libritts_r/medium/en_US-libritts_r-medium.onnx